{
  "name": "checkergie-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @checkergie/landing dev",
    "dev:landing": "pnpm --filter @checkergie/landing dev",
    "dev:admin": "pnpm --filter @checkergie/admin dev",
    "storybook": "pnpm --filter @checkergie/ui storybook",
    "build:storybook": "pnpm --filter @checkergie/ui build-storybook",
    "build": "pnpm --filter @checkergie/landing build",
    "start": "pnpm --filter @checkergie/landing start",
    "lint": "pnpm --filter @checkergie/landing lint",
    "lint:ui": "pnpm --filter @checkergie/ui lint",
    "typecheck": "pnpm --filter @checkergie/landing typecheck",
    "typecheck:ui": "pnpm --filter @checkergie/ui typecheck",
    "check:ui": "pnpm lint:ui && pnpm typecheck:ui && pnpm build:storybook",
    "check": "pnpm lint && pnpm typecheck && pnpm build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "husky": "^9.1.7",
    "next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
